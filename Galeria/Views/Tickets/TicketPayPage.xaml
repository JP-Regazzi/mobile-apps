<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Galeria.Views.Tickets.TicketPayPage"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="16,20" Spacing="24">

            <Label Text="Pague o seu"
                   FontSize="22"
                   TextColor="#333"/>

            <Label Text="ESTACIONAMENTO"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#FF6A00"
                   Margin="0,-4,0,8"/>

            <!-- Card do Ticket -->
            <Frame BorderColor="#CCCCCC"
                   BackgroundColor="Transparent"
                   Padding="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Code, StringFormat='Ticket #{0}'}"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding DurationText}"/>
                    <Label Text="{Binding EntryText, StringFormat='Entrada: {0}'}"/>
                    <Label Text="{Binding ExitText, StringFormat='Saída: {0}'}"/>
                    <Label Text="{Binding PriceText, StringFormat='Valor: {0}'}"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <!-- PIX -->
            <Frame BorderColor="#CCCCCC"
                   BackgroundColor="Transparent"
                   Padding="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="PIX"
                           FontSize="16"
                           FontAttributes="Bold"/>

                    <Label Text="QR Code"
                           FontSize="12"
                           TextColor="#777"/>

                    <Image Source="ticket_qrcode.png"
                           HeightRequest="200"
                           Aspect="AspectFit"
                           Margin="0,8,0,0"/>

                    <Label Text="Copie e cole o código abaixo:"
                           FontSize="12"
                           TextColor="#777"
                           Margin="0,8,0,0"/>

                    <Grid BackgroundColor="White"
                          Padding="12"
                          ColumnDefinitions="*,Auto">
                        <Label Text="00020126360014BR.GOV.BCB.PIX0114+5561999..."
                               FontSize="12"
                               LineBreakMode="TailTruncation"/>
                        <Image Grid.Column="1"
                               Source="icon_copy.png"
                               WidthRequest="24"
                               HeightRequest="24"
                               VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Copiar e colar"
                    HeightRequest="52"
                    CornerRadius="26"
                    BackgroundColor="#FF6A00"
                    TextColor="White"
                    Clicked="OnCopyAndPayClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
