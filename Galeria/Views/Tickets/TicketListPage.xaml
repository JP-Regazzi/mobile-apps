<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Galeria.Views.Tickets.TicketListPage"
             BackgroundColor="#F5F5F5">

    <Grid Padding="16,20"
          RowDefinitions="Auto,Auto,*">

        <Label Text="Tickets"
               FontSize="22"
               TextColor="#333"/>

        <Label Grid.Row="1"
               Text="Pagos"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#FF6A00"
               Margin="0,-4,0,16"/>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Tickets}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,12"
                           Padding="16"
                           HasShadow="False"
                           BackgroundColor="Transparent"
                           BorderColor="#CCCCCC">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Code, StringFormat='Ticket #{0}'}"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding DurationText}"/>
                            <Label Text="{Binding EntryText, StringFormat='Entrada: {0}'}"
                                   TextColor="#999"/>
                            <Label Text="{Binding ExitText, StringFormat='Saída: {0}'}"
                                   TextColor="#999"/>
                            <Label Text="{Binding PriceText, StringFormat='Valor: {0}'}"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
