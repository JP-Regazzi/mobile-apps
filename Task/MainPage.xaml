<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskCRUD.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:TaskCRUD.ViewModels"
    x:Name="MainPageRef"
    Title="Início"
    BackgroundColor="#F4F4F4">

    <ContentPage.BindingContext>
        <viewModels:TaskViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="24"
          RowDefinitions="Auto,*,Auto">

        <!-- Barra de busca -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                HeightRequest="48"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24"
                VerticalOptions="Start">
            <HorizontalStackLayout Spacing="8" Padding="16,0" VerticalOptions="Center">
                <Image Source="icon_search.png"
                       HeightRequest="20"
                       WidthRequest="20"
                       VerticalOptions="Center" />
                <Entry Placeholder="Pesquisar..."
                       BackgroundColor="Transparent"
                       Text="{Binding SearchText}"
                       PlaceholderColor="#B0B0B0"
                       TextColor="Black"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Mensagem da tela vazia -->
        <Label Grid.Row="1"
               Text="O que você deseja fazer?"
               TextColor="#B0B0B0"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="{Binding HasNoTasks}" />

        <!-- Lista de tarefas -->
        <CollectionView Grid.Row="1"
                        Margin="0,24,0,0"
                        ItemsSource="{Binding FilteredTasks}"
                        IsVisible="{Binding HasTasks}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- bolinha de done -->
                        <Border Grid.Column="0"
                                WidthRequest="18"
                                HeightRequest="18"
                                StrokeThickness="1.5"
                                Stroke="Black"
                                StrokeShape="Ellipse"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.ToggleTaskCompletedCommand, Source={x:Reference Name=MainPageRef}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsCompleted}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="Black" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>

                        <!-- título + data -->
                        <VerticalStackLayout Grid.Column="1"
                                             Margin="12,0,0,0"
                                             Spacing="2">
                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="Black">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsCompleted}"
                                                 Value="True">
                                        <Setter Property="TextDecorations"
                                                Value="Strikethrough" />
                                        <Setter Property="TextColor"
                                                Value="#707070" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding FormattedDate}"
                                   FontSize="12"
                                   TextColor="#A0A0A0">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsCompleted}"
                                                 Value="True">
                                        <Setter Property="TextDecorations"
                                                Value="Strikethrough" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>

                        <!-- lixeirinha -->
                        <Image Grid.Column="2"
                               Source="icon_trash.png"
                               HeightRequest="24"
                               WidthRequest="24"
                               HorizontalOptions="End"
                               VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.DeleteTaskCommand, Source={x:Reference Name=MainPageRef}}"
                                    CommandParameter="{Binding .}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Botão Adicionar Tarefa -->
        <Border Grid.Row="2"
                Margin="0,24,0,16"
                HeightRequest="56"
                BackgroundColor="Black"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                HorizontalOptions="Center"
                VerticalOptions="End">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddTaskTapped" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="8"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Padding="24,0">
                <Image Source="icon_plus_white.png"
                       HeightRequest="16"
                       WidthRequest="16"
                       VerticalOptions="Center" />
                <Label Text="Adicionar Tarefa"
                       TextColor="White"
                       FontSize="14"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

    </Grid>
</ContentPage>
