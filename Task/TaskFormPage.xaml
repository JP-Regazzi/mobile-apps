<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskCRUD.TaskFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="TaskFormPageRef"
    Title="Cadastro"
    BackgroundColor="#F4F4F4">

    <ScrollView>
        <Grid Padding="24"
              RowDefinitions="Auto,Auto,*,Auto">

            <!-- barra superior + X -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Padding="0,0,0,16">
                <BoxView Grid.ColumnSpan="2"
                         HeightRequest="3"
                         BackgroundColor="Black"
                         HorizontalOptions="Center"
                         WidthRequest="80"
                         CornerRadius="2" />
                <Image Grid.Column="1"
                       Source="icon_close.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       HorizontalOptions="End">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="16">

                <!-- Tarefa -->
                <Border BackgroundColor="White"
                        Stroke="Black"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">
                    <Entry Placeholder="Tarefa"
                           BackgroundColor="Transparent"
                           Text="{Binding NewTitle}"
                           TextColor="Black"
                           PlaceholderColor="#A0A0A0"
                           Margin="12,8" />
                </Border>

                <!-- Descrição -->
                <Border BackgroundColor="White"
                        Stroke="Black"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="120">
                    <Editor Placeholder="Descrição"
                            BackgroundColor="Transparent"
                            Text="{Binding NewDescription}"
                            TextColor="Black"
                            PlaceholderColor="#A0A0A0"
                            Margin="12,8"
                            AutoSize="TextChanges" />
                </Border>

                <!-- Data (apenas Entry, sem calendário) -->
                <Border BackgroundColor="White"
                        Stroke="Black"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="56"
                        Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="Data"
                               VerticalOptions="Center"
                               TextColor="#A0A0A0" />
                        <Entry Grid.Column="1"
                               BackgroundColor="Transparent"
                               Text="{Binding NewDateText, Mode=TwoWay}"
                               Placeholder="dd/mm/aaaa"
                               TextColor="Black"
                               PlaceholderColor="#A0A0A0"
                               Keyboard="Numeric"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Etapas -->
                <Grid ColumnDefinitions="*,Auto"
                      Padding="0,8,0,0">
                    <Label Text="Etapas (Subtarefas)"
                           FontAttributes="Bold"
                           TextColor="Black"
                           VerticalOptions="Center" />
                    <Border Grid.Column="1"
                            WidthRequest="32"
                            HeightRequest="32"
                            BackgroundColor="#FFD54F"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding AddSubtaskCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="+"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="20"
                               TextColor="Black" />
                    </Border>
                </Grid>

                <!-- Lista de subtarefas -->
                <CollectionView ItemsSource="{Binding NewSubtasks}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- bolinha -->
                                <Border Grid.Column="0"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        StrokeThickness="1.5"
                                        Stroke="Black"
                                        StrokeShape="Ellipse"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.ToggleSubtaskCompletedCommand, Source={x:Reference Name=TaskFormPageRef}}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsCompleted}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor"
                                                    Value="Black" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- texto Etapa X (editável) -->
                                <Entry Grid.Column="1"
                                       Margin="12,0,0,0"
                                       BackgroundColor="Transparent"
                                       Text="{Binding Title}"
                                       TextColor="Black"
                                       VerticalOptions="Center">
                                    <Entry.Triggers>
                                        <DataTrigger TargetType="Entry"
                                                     Binding="{Binding IsCompleted}"
                                                     Value="True">
                                            <Setter Property="IsEnabled"
                                                    Value="False" />
                                            <Setter Property="TextColor"
                                                    Value="#707070" />
                                        </DataTrigger>
                                    </Entry.Triggers>
                                </Entry>

                                <!-- lixeirinha -->
                                <Image Grid.Column="2"
                                       Source="icon_trash.png"
                                       HeightRequest="24"
                                       WidthRequest="24"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.DeleteSubtaskCommand, Source={x:Reference Name=TaskFormPageRef}}"
                                            CommandParameter="{Binding .}" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

            <!-- Botão Salvar -->
            <Border Grid.Row="3"
                    Margin="0,24,0,16"
                    HeightRequest="56"
                    BackgroundColor="Black"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Padding="40,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveTapped" />
                </Border.GestureRecognizers>
                <Label Text="Salvar"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>
