<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Academia.MVVM.Views.ExercicioDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalhes do exercício">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Image Source="{Binding Item.Foto}" WidthRequest="72" HeightRequest="72" Aspect="AspectFit" />
                <VerticalStackLayout>
                    <Label Text="{Binding Item.Tipo}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding Item.Data, StringFormat='Data: {0:dd/MM/yyyy}'}" />
                    <Label Text="{Binding Item.Repeticoes, StringFormat='Repetições: {0}'}" />

                    <!-- Mostra a carga só quando > 0 (trigger local, sem TargetName) -->
                    <Label x:Name="LblCarga"
                           Text="{Binding Item.Carga, StringFormat='Carga: {0} kg'}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding Item.Carga}"
                                         Value="0">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                <Button Grid.Column="0"
                        Text="Voltar"
                        Command="{Binding VoltarCommand}" />

                <ImageButton Grid.Column="1"
                             Source="lixeira"
                             BackgroundColor="#CD5C5C"
                             CornerRadius="12"
                             Padding="6"
                             WidthRequest="72"
                             HeightRequest="72"
                             Aspect="AspectFit"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Command="{Binding ExcluirCommand}" />
                
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
