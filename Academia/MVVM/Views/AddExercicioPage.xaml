<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Academia.MVVM.Views.AddExercicioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Novo exercício">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Foto automática -->
            <Image Source="{Binding Foto}" HeightRequest="140" Aspect="AspectFit" />

            <!-- Tipo -->
            <Label Text="Tipo" />
            <Picker ItemsSource="{Binding OpcoesTipo}"
                    SelectedItem="{Binding Tipo}" />

            <!-- Repetições (somente força) -->
            <VerticalStackLayout IsVisible="{Binding RepeticoesHabilitadas}">
                <Label Text="Repetições" />
                <Stepper Minimum="0" Maximum="200" Increment="1"
                         Value="{Binding Repeticoes, Mode=TwoWay}" />
                <Entry Text="{Binding Repeticoes}" Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- Duração em minutos (somente cardio) -->
            <VerticalStackLayout IsVisible="{Binding DuracaoHabilitada}">
                <Label Text="Duração (minutos)" />
                <Stepper Minimum="1" Maximum="300" Increment="1"
                         Value="{Binding DuracaoMinutos, Mode=TwoWay}" />
                <Entry Text="{Binding DuracaoMinutos}" Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- Carga (somente força) -->
            <VerticalStackLayout IsVisible="{Binding CargaHabilitada}">
                <Label Text="Carga (kg)" />
                <Slider Minimum="0" Maximum="200"
                        Value="{Binding Carga, Mode=TwoWay}" />
                <Entry Text="{Binding Carga}" Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- Data -->
            <Label Text="Data"/>
            <DatePicker Date="{Binding Data, Mode=TwoWay}" Format="dd/MM/yyyy"/>

            <!-- Ações -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                <Button Text="Salvar"
                        Grid.Column="0"
                        BackgroundColor="#4CAF50" TextColor="White"
                        Command="{Binding SalvarCommand}" />
                <Button Text="Cancelar"
                        Grid.Column="1"
                        BackgroundColor="#9E9E9E" TextColor="White"
                        Command="{Binding CancelarCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
