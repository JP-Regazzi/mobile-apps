<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Cor principal do app: verde trevo -->
    <Color x:Key="Primary">#00AB37</Color>
    <Color x:Key="PrimaryDark">#008A2C</Color>
    <Color x:Key="Secondary">#006400</Color>

    <!-- Fundo de tela principal -->
    <Color x:Key="PageBackground">#FFFFFF</Color>

    <!-- Botão -->
    <Color x:Key="ButtonBackground">#00AB37</Color>
    <Color x:Key="ButtonTextColor">#FFFFFF</Color>

    <!-- Texto geral -->
    <Color x:Key="TextPrimary">#00AB37</Color>
    <Color x:Key="TextSecondary">#222222</Color>

    <!-- Borda dos números -->
    <Color x:Key="ResultBorder">#00AB37</Color>
    <Color x:Key="ResultBackground">#FFFFFF</Color>
</ResourceDictionary>
